# Component 2 risk-registry deployment configuration
# Never commit a funded private key or an RPC URL containing credentials.
WEB3_RPC_URL=https://sepolia.example.invalid/v3/replace-me
RISK_REGISTRY_NETWORK=sepolia
TRACEABILITY_NETWORK=sepolia
RISK_REGISTRY_PRIVATE_KEY=0xREPLACE_WITH_A_64_HEX_CHARACTER_PRIVATE_KEY
RISK_REGISTRY_ADMIN=0xREPLACE_WITH_A_NONZERO_ADMIN_ADDRESS
RISK_REGISTRY_ALLOW_SEPOLIA=false

# Optional API override. When omitted, the API reads the selected network from
# shared/blockchain/contract-addresses.json.
# MEDICINE_RISK_REGISTRY_ADDRESS=0xREPLACE_AFTER_DEPLOYMENT
# MEDICINE_TRACEABILITY_ADDRESS=0xOPTIONAL_TRACEABILITY_OVERRIDE
