PORT=5001
HOST=127.0.0.1
WEB3_RPC_URL=http://127.0.0.1:8545
TRACEABILITY_NETWORK=localhost
# Required until a deployment is recorded in the existing shared address registry.
MEDICINE_TRACEABILITY_ADDRESS=

# Document API is disabled unless a separate random token (32+ chars) is set.
IPFS_API_TOKEN=
IPFS_PROVIDER=pinata
IPFS_PROVIDER_TOKEN=
IPFS_PIN_ENDPOINT=https://api.pinata.cloud/pinning/pinFileToIPFS
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
# Comma-separated SHA-256 hex hashes of files reviewed as safe for PUBLIC IPFS.
IPFS_APPROVED_SHA256=
